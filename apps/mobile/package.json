    "jsdom": "^30.0.1",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
