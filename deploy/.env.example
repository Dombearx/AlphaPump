# Konfiguracja stosu wdrożeniowego. Skopiuj do `deploy/.env` i uzupełnij.
#
# Compose czyta ten plik sam, bo leży obok `docker-compose.yml`. Do kontenerów
# trafiają wyłącznie zmienne wypisane w sekcji `environment:` — plik nie jest
# wstrzykiwany w całości, więc hasło bazy nie ląduje w procesie API pod własną
# nazwą, a tylko wewnątrz `DATABASE_URL`.
#
# `deploy/.env` jest w `.gitignore`. Nie wersjonujemy go i nie kopiujemy na
# maszynę dewelopera — sekret produkcyjny mieszka na minipc.

# --- baza ---------------------------------------------------------------------
POSTGRES_USER=alphapump
POSTGRES_DB=alphapump
# Wygeneruj: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- API ----------------------------------------------------------------------
# Sekret podpisujący sesje, minimum 32 znaki. Wygeneruj: openssl rand -base64 48
# Jego zmiana wylogowuje wszystkich — to nie jest wartość do rotowania mimochodem.
BETTER_AUTH_SECRET=

# Adres, pod którym stos jest widoczny w VPN. Wchodzi do dokumentu OpenAPI
# i do adresów zwrotnych logowania, więc musi być tym adresem, którego naprawdę
# używają telefony — nie `localhost`.
BETTER_AUTH_URL=http://100.64.0.1

# Zaufane pochodzenia, po przecinku. `alphapump://` to schemat deep linków
# aplikacji mobilnej. Panel jest pod tym samym pochodzeniem co API, więc nie
# wymaga wpisu.
TRUSTED_ORIGINS=alphapump://

# Logowanie i rejestracja przez Google — jedno i drugie, bo to ten sam przepływ:
# konto zakłada się pierwszym udanym logowaniem. Domyślnie **wyłączone**.
#
# Włączenie wymaga trzech rzeczy naraz, i to celowo: flagi niżej, kompletu
# poświadczeń, oraz zmiennej repozytorium `EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED`
# przy budowaniu aplikacji. Sama flaga daje serwer gotowy bez przycisku, sama
# zmienna w wydaniu — przycisk, którego serwer nie obsłuży.
#
# Czwarta rzecz jest poza tym plikiem: natywny Sign-In na Androidzie wymaga
# odcisku SHA-1 klucza podpisującego wydanie, zarejestrowanego jako klient
# Android w Google Cloud (obok pakietu `app.alphapump.mobile`). Bez niego
# logowanie kończy się `DEVELOPER_ERROR` dopiero na telefonie. Zmiana klucza
# podpisującego to zawsze także zmiana tam.
#
# Logowanie e-mailem działa niezależnie i nie wymaga niczego z powyższych.
GOOGLE_SIGN_IN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- warstwa semantyczna (wykrywanie duplikatów) ------------------------------
# Pusty klucz = warstwa wyłączona. Serwer wstaje normalnie i mówi o tym w logu,
# a ostrzeżenie o podobnych ćwiczeniach liczy się wtedy leksykalnie.
OPENROUTER_API_KEY=
# LLM_ENABLED=true
# EMBEDDING_MODEL=qwen/qwen3-embedding-0.6b
# RERANKER_MODEL=google/gemini-2.5-flash
# RERANKER_ENABLED=true
# LLM_TIMEOUT_MS=8000

# --- tłumaczenie nazw tagów i ćwiczeń -----------------------------------------
# Tym samym kluczem, ale osobnym wyłącznikiem. Wyłączone (albo niedostępny
# dostawca) znaczy „nazwy zostają w języku, w którym je wpisano" — zapis działa
# bez zmian.
# TRANSLATION_ENABLED=true
# TRANSLATION_MODEL=anthropic/claude-haiku-4.5
# TRANSLATION_TIMEOUT_MS=20000

# --- dyktowanie serii głosem ---------------------------------------------------
# Dwóch dostawców naraz: transkrypcja własnym kluczem i interpretacja tekstu
# kluczem OpenRoutera wyżej. Pusty klucz transkrypcji = dyktowanie wyłączone,
# czyli telefon nie pokazuje mikrofonu; zapis serii formularzem działa bez zmian.
SPEECH_TO_TEXT_API_KEY=
# VOICE_ENABLED=true
# SPEECH_TO_TEXT_URL=https://api.groq.com/openai/v1/audio/transcriptions
# SPEECH_TO_TEXT_MODEL=whisper-large-v3-turbo
# VOICE_MODEL=google/gemini-2.5-flash
# VOICE_TIMEOUT_MS=20000

# --- zgłoszenia zwrotne ---------------------------------------------------------
# Katalog na gospodarzu, w którym lądują zgłoszenia z aplikacji (tekst, nick,
# data i ostatnie logi telefonu) — jeden plik JSON na zgłoszenie, czytelny
# `cat`-em. Bez zmiennej ląduje w `deploy/feedback/`.
# FEEDBACK_DIR=./feedback

# --- wydania aplikacji na Androida ----------------------------------------------
# Katalog na gospodarzu z plikami `.apk` i manifestem `latest.json`. Caddy oddaje
# go pod `/alphapump/download`, a telefony biorą stamtąd aktualizacje. Wgrywa do niego
# `POST /apk` serwera aktualizacji, wołany przez `.github/workflows/android-release.yml`.
# Bez zmiennej ląduje w `deploy/apk/`.
# APK_DIR=./apk
#
# Zmieniasz `APK_DIR` na ścieżkę **względną**? Ustaw wtedy także
# `UPDATE_SERVER_APK_DIR` w jednostce `alphapump-update-server.service` — compose
# liczy ścieżki względne od `deploy/`, a serwer aktualizacji od katalogu
# repozytorium, więc ten sam zapis znaczyłby dla nich dwa różne katalogi.
# Ścieżka bezwzględna problemu nie ma.

# --- wydania OTA ----------------------------------------------------------------
# Katalog na gospodarzu z paczkami JavaScriptu, które aplikacja pobiera zamiast
# całego pliku `.apk`. Caddy oddaje z niego same pliki pod `/alphapump/ota`,
# a API czyta z niego opisy wydań i składa z nich manifest (`/updates/manifest`).
# Wgrywa do niego `POST /ota` serwera aktualizacji, wołany przez
# `.github/workflows/android-release.yml`. Bez zmiennej ląduje w `deploy/ota/`.
# OTA_DIR=./ota
#
# Ta sama pułapka co przy `APK_DIR` wyżej: przy ścieżce **względnej** ustaw także
# `UPDATE_SERVER_OTA_DIR` w jednostce `alphapump-update-server.service`.

# --- segregacja zgłoszeń (services/triage) --------------------------------------
# Usługa `triage` zagląda do katalogu wyżej co kilkanaście sekund, klasyfikuje
# zgłoszenia i albo zakłada issue na GitHubie, albo otwiera dyskusję na Discordzie.
#
# Trzy wartości niżej plus `OPENROUTER_API_KEY` są dla niej wymagane. W razie
# braku nie wstaje **ona** — reszta stosu działa normalnie, a w
# `docker compose logs triage` widać nazwę brakującej zmiennej i kontener
# w pętli restartów. Jeśli nie chcesz jej uruchamiać, usuń usługę `triage`
# z `docker-compose.yml`.

# Token bota z https://discord.com/developers/applications. Bot musi mieć
# włączoną intencję „MESSAGE CONTENT" i uprawnienia na kanale: wysyłanie
# wiadomości, tworzenie wątków publicznych, wysyłanie w wątkach, czytanie
# historii wiadomości.
DISCORD_BOT_TOKEN=
# Identyfikator kanału tekstowego (tryb dewelopera w Discordzie → PPM na kanale
# → „Kopiuj ID kanału"). Kanał musi być tekstowy, nie forum — usługa sama
# zakłada wątki pod swoimi wiadomościami.
DISCORD_CHANNEL_ID=

# Token GitHuba do zakładania issue, z
# https://github.com/settings/personal-access-tokens → „Generate new token".
# Wystarczy token o dostępie do jednego repozytorium (fine-grained) z prawami:
# Issues → Read and write, Pull requests → Read-only, Contents → Read-only.
# To token konta, nie sekret repozytorium — issue powstają jako jego właściciel.
# Ma datę wygaśnięcia: po niej zakładanie issue przestaje działać.
TRIAGE_GITHUB_TOKEN=

# Token, którym panel administracyjny wyzwala przegląd zgłoszeń na żądanie
# (przycisk „Uruchom przegląd zgłoszeń" w ekranie „Zgłoszenia"). Nie pochodzi
# z żadnej usługi zewnętrznej — wymyślasz go sam: openssl rand -base64 32.
# Ta jedna wartość obsługuje obie strony: `api` wysyła ją, `triage` sprawdza,
# oba kontenery czytają ją stąd, więc nie ma czego z niczym uzgadniać. Bez niej
# usługa `triage` się nie uruchomi — tak samo jak bez `TRIAGE_GITHUB_TOKEN`
# wyżej.
TRIAGE_HTTP_TOKEN=

# TRIAGE_GITHUB_REPO=Dombearx/AlphaPump
# Co ile sekund usługa zagląda do katalogu zgłoszeń. Zgłoszenie ma trafić do
# segregacji wtedy, kiedy je napisano — pusty przebieg to `glob` po katalogu
# i jedno zapytanie do SQLite'a, więc częstość nic nie kosztuje.
# TRIAGE_FEEDBACK_POLL_SECONDS=15
# Karencja przed kolejnym podejściem do zgłoszenia, na którym poprzednie poległo.
# Bez niej trzy podejścia z `TRIAGE_MAX_ATTEMPTS` poszłyby w niecałą minutę
# i chwilowa awaria OpenRoutera odkładałaby zgłoszenie na bok bezpowrotnie.
# TRIAGE_RETRY_AFTER_SECONDS=900
# TRIAGE_TIMEZONE=Europe/Warsaw
# Klasyfikacja idzie na tańszy model, pisanie treści issue na mocniejszy.
# TRIAGE_CLASSIFIER_MODEL=openai/gpt-5.6-terra
# TRIAGE_WRITER_MODEL=anthropic/claude-sonnet-5
# Etykiety na zakładanych issue. `TRIAGE_LABEL_TRIGGER` jest jednocześnie
# wyzwalaczem akcji `.github/workflows/agent-issue.yml` — zmiana tutaj wymaga
# zmiany także tam.
# TRIAGE_LABEL_TRIGGER=ai-triage
# TRIAGE_LABEL_BUG=bug
# TRIAGE_LABEL_FEATURE=enhancement
# Co ile sekund pytać GitHuba o pull requesty do śledzonych issue.
# TRIAGE_PR_POLL_SECONDS=120
# Port ręcznego wyzwolenia przeglądu — wewnętrzny do sieci Compose, bez `ports:`
# na gospodarzu. Zmiana tutaj wymaga tej samej zmiany w `TRIAGE_URL` API (patrz
# `docker-compose.yml`, liczy się sama, jeśli zmienisz tylko ten port).
# TRIAGE_HTTP_PORT=8090
# Tryb próbny: klasyfikacja i wykrywanie duplikatów działają naprawdę, ale nic
# nie powstaje — wynik widać wyłącznie w `docker compose logs triage`.
# TRIAGE_DRY_RUN=false
# TRIAGE_LOG_LEVEL=INFO

# --- sieć ---------------------------------------------------------------------
# Adres i port, na których nasłuchuje Caddy. `0.0.0.0` odpowiada decyzji
# z dokumentu stacku: sieć lokalna minipc jest traktowana jako zaufana.
# Wpisanie tu adresu interfejsu NetBird (`ip -4 addr show wt0`) zawęża dostęp
# do samego VPN-u i jest wyborem ostrożniejszym.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
