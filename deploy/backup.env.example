# Środowisko crona kopii zapasowych na minipc.
#
# Skopiuj do `/etc/alphapump/backup.env`, uzupełnij i zabezpiecz:
#   sudo install -D -m 600 deploy/backup.env.example /etc/alphapump/backup.env
#
# Plik nie zawiera żadnego sekretu odszyfrowującego. `age1…` to klucz **publiczny**
# — pozwala wyłącznie zaszyfrować. Włamanie na minipc nie daje więc dostępu do
# kopii leżących na Dysku, bo klucz prywatny nigdy tu nie trafia.

# Eksport idzie **wewnątrz kontenera API**: Postgres nie wystawia portu na
# gospodarza, więc `scripts/backup.sh` nie ma jak sam dosięgnąć bazy. Szyfrowanie
# i wysyłka zostają na gospodarzu, bo to tam leżą klucz publiczny i konfiguracja
# rclone.
#
# `-T` jest konieczne: bez niego docker przydzieliłby pseudoterminal i wstawił
# w strumień archiwum znaki sterujące.
ALPHAPUMP_EXPORT_CMD=docker compose -f /opt/alphapump/deploy/docker-compose.yml exec -T api node /app/apps/api/dist/cli/export.js

# Klucze publiczne odbiorców, po przecinku. Dwa, świadomie: klucz główny
# (menedżer haseł plus wydruk) oraz klucz CI, którym comiesięczna próba
# odtworzenia rozpakowuje kopię bez wystawiania automatyce klucza głównego.
AGE_RECIPIENTS=age1główny…,age1ci…

# Zdalny katalog rclone. Konfigurację (`rclone.conf`) tworzy się na maszynie
# z przeglądarką przez `rclone authorize` i przenosi na minipc.
RCLONE_REMOTE=gdrive:alphapump-backups

# Opcjonalne.
RETENTION_DAYS=90
BACKUP_PREFIX=alphapump
