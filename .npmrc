dedupe-peer-dependents=true
strict-peer-dependencies=false
# React Native's/Expo's babel presets resolve some plugins (e.g.
# @babel/plugin-transform-react-jsx) by bare name from the project root
# instead of requiring them directly, so they need a flat node_modules —
# pnpm's default strict linking leaves those buried inside
# @react-native/babel-preset's own dependency tree, unresolvable from here.
node-linker=hoisted
