# Adres API wewnątrz VPN. Z niego wyliczają się oba wyjątki od szyfrowania
# ruchu — ATS po stronie iOS i network security config po stronie Androida —
# więc nie ma jak ustawić jednego i przeoczyć drugiego.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Logowanie przez Google. Puste znaczy „metoda wyłączona"; e-mail z hasłem
# działa dalej. Identyfikator webowy jest wymagany także na Androidzie — to on
# wchodzi w `idToken`, który weryfikuje serwer.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
