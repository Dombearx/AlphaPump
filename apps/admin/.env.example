# Adres API. W trybie deweloperskim jest celem proxy Vite (`/api-proxy`),
# więc przeglądarka widzi jedno pochodzenie i nie wchodzi w CORS.
VITE_API_URL=http://localhost:3000

# Adres, pod którym panel woła API w przeglądarce. Puste znaczy „przez proxy
# Vite" (tryb dev). Na produkcji panel i API stoją za tym samym Caddym, więc
# wystarczy ścieżka względna albo pełny adres z VPN.
VITE_API_BASE=
