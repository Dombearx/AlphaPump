# syntax=docker/dockerfile:1
#
# Obraz warstwy wejściowej: panel administracyjny **razem** z Caddym.
#
# Panel jest zbiorem plików statycznych, a nie procesem. Osobny kontener na
# panel musiałby więc albo serwować je własnym serwerem (drugi serwer HTTP obok
# Caddy'ego), albo podawać je Caddy'emu wolumenem współdzielonym — co przy
# aktualizacji wymaga kolejności startu i kontenera pomocniczego kopiującego
# pliki. Wpieczenie `dist/` w obraz Caddy'ego usuwa oba problemy: aktualizacja
# panelu to podmiana jednego obrazu, a Caddy nadal jest tym samym zwykłym
# reverse proxy, jakiego wymaga dokument stacku.
#
# `VITE_API_BASE` zostaje **puste**. Panel i API wychodzą spod tego samego
# pochodzenia (Caddy rozdziela je ścieżką), więc ciasteczko sesji nie jest
# ciasteczkiem między witrynami.

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV CI=1
RUN corepack enable
WORKDIR /app

# --------------------------------------------------------------- manifesty ---
FROM base AS manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/admin/package.json apps/admin/
COPY apps/mobile/package.json apps/mobile/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/

# --------------------------------------------------------------- budowanie ---
FROM manifests AS build
# `--ignore-scripts`: wirtualny magazyn pnpm dostaje `better-sqlite3` (zależność
# deweloperską spoza tego filtra, wciąganą przez rozwiązywanie zależności
# równorzędnych `better-auth`), a jego skrypt instalacyjny kompiluje moduł
# natywny — czego `node:alpine` nie umie. Vite go nie potrzebuje: rolldown
# przychodzi z gotowym plikiem binarnym w zależności opcjonalnej.
RUN --mount=type=cache,id=alphapump-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "@alphapump/admin..." --ignore-scripts

COPY tsconfig.base.json ./
COPY packages/core packages/core
COPY apps/admin apps/admin

RUN pnpm --filter "@alphapump/admin..." run build

# -------------------------------------------------------------- uruchomienie -
# ------------------------------------------------ Caddy z obsługą DNS-01 -----
# Obraz `caddy:2-alpine` nie zawiera **żadnego** modułu dostawcy DNS, a bez
# takiego modułu Caddy nie umie wykonać wyzwania DNS-01 — czyli jedynego, które
# działa dla serwera bez publicznego adresu (uzasadnienie w `deploy/Caddyfile`).
# Moduły ACME są w Caddym wkompilowane, nie wczytywane z pliku, więc jedynym
# sposobem jest przebudowanie binarki `xcaddy`.
#
# Dostawca jest argumentem budowy, a nie wartością wpisaną na stałe, bo domena
# może kiedyś przenieść się gdzie indziej — wtedy zmienia się ta jedna wartość
# (i `ACME_DNS_PROVIDER` w `deploy/.env`, żeby nazwa w konfiguracji zgadzała się
# z wkompilowanym modułem). Lista dostawców: https://github.com/caddy-dns
#
# To jest jedyny etap budowy sięgający po zależności z sieci przy każdym
# przebudowaniu obrazu — kompiluje Caddy'ego od zera i trwa dłużej niż reszta
# tego pliku razem wzięta.
FROM caddy:2-builder-alpine AS caddy-build

ARG CADDY_DNS_MODULE=github.com/caddy-dns/duckdns
RUN xcaddy build --with "${CADDY_DNS_MODULE}"

# -------------------------------------------------------------- uruchomienie -
FROM caddy:2-alpine

# Binarka z etapu wyżej **zastępuje** tę z obrazu. Podstawa systemowa zostaje ta
# sama, więc rozjazd wersji między `2-builder-alpine` a `2-alpine` dotyczy
# wyłącznie warstwy, której i tak nie używamy.
COPY --from=caddy-build /usr/bin/caddy /usr/bin/caddy

COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/admin/dist /srv

# 443 obok 80: po włączeniu TLS-u port 80 zostaje wyłącznie na przekierowanie
# do HTTPS i na stary adres w trakcie migracji (patrz `deploy/Caddyfile`).
EXPOSE 80 443
