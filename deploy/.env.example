# Konfiguracja stosu wdrożeniowego. Skopiuj do `deploy/.env` i uzupełnij.
#
# Compose czyta ten plik sam, bo leży obok `docker-compose.yml`. Do kontenerów
# trafiają wyłącznie zmienne wypisane w sekcji `environment:` — plik nie jest
# wstrzykiwany w całości, więc hasło bazy nie ląduje w procesie API pod własną
# nazwą, a tylko wewnątrz `DATABASE_URL`.
#
# `deploy/.env` jest w `.gitignore`. Nie wersjonujemy go i nie kopiujemy na
# maszynę dewelopera — sekret produkcyjny mieszka na minipc.

# --- baza ---------------------------------------------------------------------
POSTGRES_USER=alphapump
POSTGRES_DB=alphapump
# Wygeneruj: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- API ----------------------------------------------------------------------
# Sekret podpisujący sesje, minimum 32 znaki. Wygeneruj: openssl rand -base64 48
# Jego zmiana wylogowuje wszystkich — to nie jest wartość do rotowania mimochodem.
BETTER_AUTH_SECRET=

# Adres, pod którym stos jest widoczny w VPN. Wchodzi do dokumentu OpenAPI
# i do adresów zwrotnych logowania, więc musi być tym adresem, którego naprawdę
# używają telefony — nie `localhost`.
BETTER_AUTH_URL=http://100.64.0.1

# Zaufane pochodzenia, po przecinku. `alphapump://` to schemat deep linków
# aplikacji mobilnej. Panel jest pod tym samym pochodzeniem co API, więc nie
# wymaga wpisu.
TRUSTED_ORIGINS=alphapump://

# Logowanie Google. Bez kompletu obu wartości metoda jest wyłączona, a logowanie
# e-mailem działa dalej.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- warstwa semantyczna (wykrywanie duplikatów) ------------------------------
# Pusty klucz = warstwa wyłączona. Serwer wstaje normalnie i mówi o tym w logu,
# a ostrzeżenie o podobnych ćwiczeniach liczy się wtedy leksykalnie.
OPENROUTER_API_KEY=
# LLM_ENABLED=true
# EMBEDDING_MODEL=qwen/qwen3-embedding-0.6b
# RERANKER_MODEL=google/gemini-2.5-flash
# RERANKER_ENABLED=true
# LLM_TIMEOUT_MS=8000

# --- zgłoszenia zwrotne ---------------------------------------------------------
# Katalog na gospodarzu, w którym lądują zgłoszenia z aplikacji (tekst, nick,
# data i ostatnie logi telefonu) — jeden plik JSON na zgłoszenie, czytelny
# `cat`-em. Bez zmiennej ląduje w `deploy/feedback/`.
# FEEDBACK_DIR=./feedback

# --- sieć ---------------------------------------------------------------------
# Adres i port, na których nasłuchuje Caddy. `0.0.0.0` odpowiada decyzji
# z dokumentu stacku: sieć lokalna minipc jest traktowana jako zaufana.
# Wpisanie tu adresu interfejsu NetBird (`ip -4 addr show wt0`) zawęża dostęp
# do samego VPN-u i jest wyborem ostrożniejszym.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
