node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

.env
.env.*
!.env.example

.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*

.expo/
.idea/
.vscode/*
!.vscode/extensions.json

# Katalogi natywne generuje `expo prebuild` — trzymamy je poza repozytorium,
# bo źródłem prawdy jest app.config.js i wtyczki, a nie wygenerowany projekt.
apps/mobile/android/
apps/mobile/ios/

# Wydany plik aplikacji leży poza repozytorium — patrz deploy/apk/.gitkeep.
deploy/apk/*
!deploy/apk/.gitkeep

# Wydania OTA — paczki JavaScriptu i ich pliki. Patrz deploy/ota/.gitkeep.
deploy/ota/*
!deploy/ota/.gitkeep

# Zgłoszenia zwrotne z aplikacji — dane użytkowników, nie kod. Patrz deploy/feedback/.gitkeep.
deploy/feedback/*
!deploy/feedback/.gitkeep

# Awaryjny cel woluminu kopii zapasowych. Compose nie umie „nie podmontować"
# warunkowo, więc bez `BACKUP_DIR` w `deploy/.env` wolumin wskazuje tutaj i jest
# pusty. Prawdziwe kopie leżą poza repozytorium — patrz `deploy/backup.env.example`.
deploy/backups/

# To samo lokalnie: domyślny FEEDBACK_DIR poza deploy/, gdy API chodzi z `pnpm start`.
apps/api/data/

# Robocze pliki graficzne (źródła do ręcznego przycinania ikon itp.) — nie wchodzą
# do repo, ostateczne assety trzymamy w apps/mobile/assets/.
images/

# Segregacja zgłoszeń (services/triage) — środowisko i pamięci podręczne
# Pythona. `uv.lock` jest wersjonowany, bo od niego zależy powtarzalność CI.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Lokalna konfiguracja minipc (keystore, notatki z sekretami) — nie do repo.
minipc-config/
