# Konfiguracja API. Skopiuj do `.env` i uzupełnij.
# Wszystkie zmienne bez wartości domyślnej są wymagane — serwer nie wstanie bez nich.

# Adres bazy PostgreSQL.
DATABASE_URL=postgres://alphapump:alphapump@localhost:5432/alphapump

# Sekret podpisujący sesje, minimum 32 znaki.
# Wygeneruj: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Publiczny adres API — wchodzi do adresów zwrotnych i do dokumentu OpenAPI.
BETTER_AUTH_URL=http://localhost:3000

# Dodatkowe zaufane origin-y po przecinku (schemat aplikacji mobilnej, panel admina).
TRUSTED_ORIGINS=alphapump://,http://localhost:5173

# Logowanie Google. Bez kompletu obu wartości metoda jest po prostu wyłączona,
# a logowanie e-mailem działa dalej.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nasłuch. `0.0.0.0` jest świadome: sieć lokalna minipc jest traktowana jako zaufana.
HOST=0.0.0.0
PORT=3000

# --- Wykrywanie duplikatów: warstwa semantyczna i LLM (etap 12) --------------
# Cała warstwa jest wyłączalna jedną zmienną. Wyłączona nie psuje niczego:
# ostrzeżenie o podobnych ćwiczeniach liczy się wtedy leksykalnie, a tworzenie
# ćwiczeń działa bez zmian.
LLM_ENABLED=true

# Klucz OpenRoutera. Bez niego warstwa jest po prostu wyłączona — serwer wstaje
# normalnie i mówi o tym w logu. Klucz nigdy nie trafia do aplikacji mobilnej:
# wszystkie wywołania modeli wychodzą z backendu.
OPENROUTER_API_KEY=

# Model embeddingów. MUSI zwracać wektor o wymiarze zgodnym z kolumną
# `exercise_embeddings.embedding` (1024) — inny wymiar jest odrzucany przy
# zapisie, bo indeks HNSW ma wymiar wpisany w schemat. Nazwy modeli sprawdź
# w katalogu OpenRoutera; zmiana modelu wymaga przeliczenia wektorów.
EMBEDDING_MODEL=qwen/qwen3-embedding-0.6b

# Re-ranker (warstwa 3): ocenia kandydatów i pisze uzasadnienie. Można wyłączyć
# osobno — warstwy 1 i 2 dalej znajdują duplikaty, tylko bez komentarza.
RERANKER_MODEL=google/gemini-2.5-flash
RERANKER_ENABLED=true

# Limit czasu na wywołanie modelu. Krótki świadomie: ostrzeżenie o duplikacie
# jest podpowiedzią w trakcie pisania nazwy, więc lepiej jej nie pokazać niż
# kazać czekać.
LLM_TIMEOUT_MS=8000

# --- Tłumaczenie nazw tagów i ćwiczeń ----------------------------------------
# Nazwa podana w jednym języku dostaje resztę z modelu — po zapisie i **poza**
# ścieżką żądania, więc zapis nie czeka na dostawcę i nie wywraca się, gdy ten
# nie odpowie. Wiersz zostaje wtedy z nazwą kanoniczną, czyli wygląda tak, jak
# wyglądał przed dodaniem języków.
#
# Jedzie tym samym kluczem OpenRoutera co warstwy wyżej, ale ma własny
# wyłącznik: tłumaczenie ma sens także tam, gdzie re-ranker wyłączono dla kosztów.
TRANSLATION_ENABLED=true
TRANSLATION_MODEL=anthropic/claude-haiku-4.5

# Limit czasu tłumaczenia — dłuższy niż `LLM_TIMEOUT_MS`, bo nikt na nie nie
# czeka: nazwy dochodzą kolejką po zapisie.
TRANSLATION_TIMEOUT_MS=20000

# --- Dyktowanie serii głosem -------------------------------------------------
# Nagranie z telefonu jedzie na `POST /voice/set`, wraca stamtąd transkrypcją
# i rozpoznaną serią — a zapisuje ją dopiero człowiek, w formularzu. Funkcja
# stoi na **dwóch** dostawcach naraz: transkrypcji (klucz niżej) i modelu
# interpretującego tekst (klucz OpenRoutera wyżej). Brak któregokolwiek znaczy
# „dyktowanie wyłączone" — aplikacja nie pokazuje wtedy mikrofonu, a zapis serii
# formularzem działa bez zmian.
VOICE_ENABLED=true

# Usługa zamieniająca nagranie na tekst. Adres, a nie nazwa dostawcy: pasuje
# każda mówiąca protokołem `POST /audio/transcriptions` OpenAI — Groq (poniżej),
# OpenAI albo lokalny `whisper.cpp` za cienkim serwerkiem.
SPEECH_TO_TEXT_URL=https://api.groq.com/openai/v1/audio/transcriptions
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_MODEL=whisper-large-v3-turbo

# Model wyciągający z transkrypcji ćwiczenie i pomiary — u dostawcy z
# `OPENROUTER_API_KEY`. Dopasowuje wyłącznie do ćwiczeń, które użytkownik już
# ma; nowych nie zakłada.
VOICE_MODEL=google/gemini-2.5-flash

# Limit czasu na transkrypcję i na model, każdy z osobna. Dłuższy niż
# `LLM_TIMEOUT_MS`, bo tu użytkownik nacisnął przycisk i czeka na wynik.
VOICE_TIMEOUT_MS=20000
