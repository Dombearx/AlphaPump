# Caddy: jedno pochodzenie dla API i panelu.
#
# Podział jest **ścieżką, nie hostem**, i to jest decyzja, nie wygoda. Panel
# uwierzytelnia się ciasteczkiem sesji; osobny host dla panelu zrobiłby z niego
# ciasteczko między witrynami. Przy jednym pochodzeniu problem nie powstaje.
#
# Konsekwencja: **lista ścieżek niżej jest kontraktem**. Ścieżka, której tu nie
# ma, nie trafia do API — trafia do panelu, który odda na nią `index.html`
# ze statusem 200. Klient dostałby wtedy HTML zamiast JSON-a i błąd wyglądałby na
# awarię parsera, a nie na literówkę w konfiguracji. Pilnuje tego test
# `apps/api/tests/deploy.test.ts`: sprawdza, że każda trasa opisana w OpenAPI
# pasuje do którejś ścieżki poniżej i że żadna trasa panelu do nich nie pasuje.
#
# ------------------------------------------------------------------ TLS ------
#
# Certyfikat jest z Let's Encrypt i **odnawia się sam** — Caddy sięga po nowy,
# gdy zostaje jedna trzecia okresu ważności, czyli około trzydziestu dni przed
# wygaśnięciem. Nie ma tu żadnego crona do napisania ani niczego do odhaczenia
# w kalendarzu; jedyne, co musi działać, to ruch wychodzący z minipc.
#
# Wyzwaniem jest **DNS-01**, i to nie jest wybór stylistyczny. Pozostałe dwa
# (HTTP-01, TLS-ALPN-01) polegają na tym, że serwer Let's Encrypt łączy się
# z naszym serwerem od zewnątrz — a ten stoi w NetBirdzie, bez przekierowanych
# portów, i osiągalny z internetu nie jest ani nie ma być. DNS-01 dowodzi
# kontroli nad domeną wpisem TXT w DNS-ie, więc nikt się tu do niczego nie
# łączy: Caddy sam dopisuje `_acme-challenge.<domena>`, czeka aż będzie widoczny,
# i sam go kasuje po wydaniu certyfikatu.
#
# Publiczna jest przez to wyłącznie **nazwa**. Rekord A może wskazywać na adres
# z NetBirda (`100.64.x.x`) — nikt spoza VPN i tak się tam nie dobije, a telefony
# w VPN dostają certyfikat, któremu ufają bez instalowania czegokolwiek.
#
# Moduł DNS-a jest **wkompilowany w binarkę** (`deploy/Dockerfile.web`,
# argument `CADDY_DNS_MODULE`), bo obraz `caddy:2-alpine` nie zawiera żadnego.
# Nazwa dostawcy niżej musi więc odpowiadać modułowi, z którym zbudowano obraz —
# rozjazd kończy się `module not registered: dns.providers.<nazwa>` przy starcie
# kontenera, czyli od razu i z nazwą własną problemu w logu.
{
	# Panel administracyjny Caddy'ego nie jest nikomu potrzebny, a nasłuchuje
	# na 2019 bez uwierzytelnienia.
	admin off
	# `email` świadomie nie ma. Adres w koncie ACME służy Let's Encryptowi
	# wyłącznie do ostrzegania o **wygasającym** certyfikacie — czyli jest
	# siatką bezpieczeństwa dla wdrożeń, które odnawiają ręcznie. To odnawia
	# się samo, a pusta zmienna środowiskowa w tym miejscu jest błędem składni,
	# nie brakiem opcji. Chcesz te powiadomienia: dopisz tu `email adres@…`.
}

# Kanoniczny adres stosu — nazwa, na którą wystawiany jest certyfikat.
#
# `SITE_ADDRESS` bez wartości znaczy `:80`, czyli **stary tryb**: zwykłe HTTP,
# bez certyfikatu i bez ani jednego zapytania do Let's Encryptu (przy nasłuchu
# na samym porcie 80 Caddy nie włącza automatycznego HTTPS). Tak jedzie CI
# w `.github/workflows/deploy-stack.yml` i tak da się postawić stos lokalnie,
# nie mając żadnej domeny. Wpisanie nazwy domeny włącza TLS i nic poza tym.
{$SITE_ADDRESS::80} {
	encode gzip

	tls {
		# Nazwa dostawcy DNS i token do jego API. Token czytany jest
		# `{env.…}`, czyli **w czasie działania**, a nie podstawiany przy
		# wczytaniu konfiguracji — dzięki temu nie ląduje w `caddy adapt`
		# ani w zrzucie konfiguracji, którym łatwo się podzielić w zgłoszeniu
		# błędu.
		dns {$ACME_DNS_PROVIDER:duckdns} {env.ACME_DNS_TOKEN}
		# Czym sprawdzać, czy wpis TXT jest już widoczny. Bez tego Caddy pyta
		# resolwera systemowego — a na minipc jest nim **NetBird**, który
		# odpowiada na własne nazwy i przekazuje resztę dalej. Sprawdzanie
		# propagacji przez resolwera z rozdwojonym widokiem świata to
		# dokładnie ten rodzaj awarii, który objawia się raz na trzy miesiące
		# przy odnowieniu, o czwartej rano.
		resolvers 1.1.1.1 8.8.8.8
	}

	# Sufit na ciało żądania. API ma własny, ciaśniejszy limit (`BODY_LIMIT_BYTES`
	# w `apps/api/src/app.ts`) — ten jest przed nim i chroni to, czego tamten nie
	# widzi: pliki oddawane przez `file_server` i sam proces Caddy'ego. Wartość
	# jest z zapasem względem limitu archiwum, bo import jedzie tędy.
	request_body {
		max_size 160MB
	}

	# Ścieżki API. `path` przyjmuje wiele wzorców i łączy je alternatywą;
	# gwiazdka pasuje do dowolnego dalszego ciągu, brak gwiazdki znaczy
	# dopasowanie dokładne. Pary w rodzaju `/tags /tags/*` są celowe: samo
	# `/tags*` łapałoby też `/tagsomething`, czyli zabierało panelowi ścieżki,
	# których API nie obsługuje.
	#
	# Lista jest w **jednej linii** świadomie. Złamana odwrotnym ukośnikiem jest
	# czytelniejsza, ale `caddy fmt` przestawia wtedy wcięcia po swojemu
	# i serwer dokłada przy każdym starcie ostrzeżenie o niesformatowanej
	# konfiguracji — czyli szum w logu dokładnie wtedy, gdy się do niego zagląda.
	@api path /health /openapi.json /me /rankings /export /import /feedback /api/auth/* /tags /tags/* /exercises /exercises/* /sets /sets/* /voice/* /cycles /cycles/* /sync/* /admin/* /updates/*

	handle @api {
		reverse_proxy api:3000 {
			# Import archiwum i push synchronizacji potrafią jechać długo przy
			# pierwszym wgraniu historii. Domyślne limity Caddy'ego są hojne,
			# ale nagłówek odpowiedzi ustawiamy jawnie, żeby wydłużenie było
			# zmianą jednej liczby, a nie odkryciem, gdzie ten limit siedzi.
			transport http {
				response_header_timeout 120s
			}
		}
	}

	# Manifest wydania aplikacji na Androida — jedyny plik w tym stosie, który
	# **nie może** wyjść z pamięci podręcznej klienta.
	#
	# `file_server` oddaje pliki statyczne z `Last-Modified`, ale bez
	# `Cache-Control`. Dla klienta HTTP jest to zaproszenie do cache'owania
	# heurystycznego (RFC 9111 §4.2.2): świeżość liczy się wtedy jako ułamek
	# wieku pliku, więc manifest leżący od dziesięciu godzin bywa uznawany za
	# aktualny przez następną godzinę — bez pytania serwera. OkHttp pod
	# `fetch`-em Androida robi dokładnie to. Efekt: wydanie jest na minipc,
	# a telefon dowiaduje się o nim godzinę później i nie da się tego
	# odtworzyć na żądanie. Sama aplikacja prosi o `no-store`, ale zgadywanie,
	# czy klient tę prośbę uszanuje, jest gorsze niż powiedzenie tego wprost.
	#
	# Plików `.apk` i `.pbw` to nie dotyczy: ich nazwa zawiera numer wydania, więc
	# treść pod danym adresem nigdy się nie zmienia.
	#
	# Manifesty są dwa, bo odpowiadają na dwa pytania: `latest.json` mówi, co
	# zainstalować na telefonie, a `watch.json` — co na zegarku. Oba muszą omijać
	# pamięć podręczną z tego samego powodu.
	@manifest path /alphapump/download/latest.json /alphapump/download/watch.json
	header @manifest Cache-Control "no-store"

	# Wydania aplikacji na Androida — katalog `deploy/apk/` gospodarza, wpięty
	# wolumenem w `docker-compose.yml`.
	#
	# Osobny `handle`, choć `file_server` panelu oddałby te pliki i tak. Powód
	# jest ten sam, który uzasadnia listę `@api` wyżej: bez tego brakujący plik
	# nie daje 404, tylko `index.html` ze statusem 200. Aplikacja pobierałaby
	# wtedy stronę HTML zamiast pakietu — a że nazwa pliku w manifeście jest
	# jedynym miejscem, w którym da się o literówkę, jest to dokładnie ta
	# pomyłka, którą trzeba zobaczyć od razu. (Sumę kontrolną aplikacja i tak
	# sprawdza, więc takiego „pakietu" nie zainstaluje — ale komunikat o
	# niezgodnej sumie prowadzi w złą stronę.)
	#
	# `browse` daje listę plików pod `/alphapump/download/`. Stąd bierze się **pierwszą**
	# instalację: aplikacja, której jeszcze nie ma na telefonie, nie ma jak
	# zaproponować własnej aktualizacji.
	# Dwa wzorce, bo `handle` przyjmuje tylko jeden argument — a samo `/alphapump/download`,
	# bez ukośnika, ma trafić tu, a nie do panelu (`file_server` przekieruje je
	# wtedy na `/alphapump/download/` i pokaże listę).
	@wydania path /alphapump/download /alphapump/download/*

	handle @wydania {
		root * /srv
		file_server browse
	}

	# Pliki wydań OTA — paczki JavaScriptu, które telefon pobiera zamiast całego
	# pliku `.apk`. Katalog `deploy/ota/` gospodarza, wpięty woluminem
	# w `docker-compose.yml` i zapisywany przez `deploy/update_server.py`.
	#
	# Sam manifest **nie** jest tutaj: zależy od nagłówków żądania i jest
	# `multipart/mixed`, więc obsługuje go API pod `/updates/manifest`.
	# Tu są wyłącznie pliki, po które telefon sięga po przeczytaniu manifestu.
	#
	# Każdy z nich nazywa się swoim hashem, więc treść pod danym adresem nigdy
	# się nie zmienia — stąd `immutable`. Bez tego telefon przy każdym wydaniu
	# pobiera ponownie komplet obrazków i czcionek, które już ma, mimo że
	# zmieniła się wyłącznie paczka JavaScriptu. To jest różnica między
	# aktualizacją ważącą dwa megabajty a ważącą dwadzieścia.
	@ota path /alphapump/ota/*
	header @ota Cache-Control "public, max-age=31536000, immutable"

	handle @ota {
		root * /srv
		file_server
	}

	# Wszystko pozostałe to panel: pliki statyczne, a dla ścieżek routera
	# (`/users`, `/library`, `/data`) `index.html`, bo SPA obsługuje je po
	# stronie przeglądarki.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Stary adres — ten, który telefony i zegarki mają zapisany z czasów bez TLS-u.
#
# Bez tego bloku przejście na HTTPS jest **twardym odcięciem**: certyfikatu na
# adres IP wystawić się nie da, więc aplikacja, która ma w konfiguracji
# `http://100.64.0.1`, po prostu przestaje trafiać na serwer — a nową wersję
# z nowym adresem pobiera dokładnie stamtąd. Przekierowanie rozwiązuje jajko
# i kurę: stary adres dalej odpowiada, tyle że wskazuje na nowy.
#
# Kanonicznej nazwy to nie dotyczy i nie ma jej tu z rozmysłem — dla niej Caddy
# stawia przekierowanie z portu 80 sam, i robi to kodem **308**, który zachowuje
# metodę i ciało żądania (`POST` po przekierowaniu zostaje `POST`-em). Tutaj jest
# `permanent`, czyli 301, bo to jest przeprowadzka klientów, a nie przekierowanie
# schematu — i tak ma zostać w ich pamięci.
#
# `HSTS` świadomie nie ma: nagłówek każe przeglądarce **nigdy** nie odzywać się
# do tej nazwy po HTTP, co skasowałoby ten blok w połowie migracji.
#
# Pusta zmienna znaczy `legacy.invalid` — nazwa z zarezerwowanej domeny, której
# nikt nie wyśle, więc blok jest wtedy martwy i nie wchodzi nikomu w drogę.
# Adresów może być kilka po przecinku, ale **każdy z własnym `http://`**; bez
# schematu Caddy uzna go za nazwę do wystawienia certyfikatu.
{$LEGACY_ADDRESS:http://legacy.invalid} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

# Sprawdzenie zdrowia kontenera — wyłącznie dla `healthcheck` z `docker-compose.yml`.
#
# Blok istnieje, bo dopasowanie idzie po nagłówku `Host`, a `wget` z wnętrza
# kontenera puka pod `127.0.0.1` i taki właśnie `Host` wysyła. Po włączeniu TLS-u
# kanoniczny blok wyżej nasłuchuje pod **nazwą domeny** i żądania spod adresu
# pętli zwrotnej przestałyby do niego pasować — healthcheck dostawałby 404
# i Compose uznałby zdrowy stos za padnięty.
#
# Jest tu sama `/health`, i to celowo: to nie jest drugie wejście do stosu,
# tylko odpowiedź na jedno pytanie. Ruch z zewnątrz nigdy nie ma tu `Host`-a
# `127.0.0.1`. (Wynika z tego jedno: `deploy/smoke.sh` uruchamiany pod adresem
# `http://127.0.0.1` sprawdzi tylko `/health` — sprawdzaj stos pod nazwą, którą
# naprawdę widzą telefony.)
http://127.0.0.1 {
	handle /health {
		reverse_proxy api:3000
	}
}
