# Konfiguracja API. Skopiuj do `.env` i uzupełnij.
# Wszystkie zmienne bez wartości domyślnej są wymagane — serwer nie wstanie bez nich.

# Adres bazy PostgreSQL.
DATABASE_URL=postgres://alphapump:alphapump@localhost:5432/alphapump

# Sekret podpisujący sesje, minimum 32 znaki.
# Wygeneruj: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Publiczny adres API — wchodzi do adresów zwrotnych i do dokumentu OpenAPI.
BETTER_AUTH_URL=http://localhost:3000

# Dodatkowe zaufane origin-y po przecinku (schemat aplikacji mobilnej, panel admina).
TRUSTED_ORIGINS=alphapump://,http://localhost:5173

# Logowanie Google. Bez kompletu obu wartości metoda jest po prostu wyłączona,
# a logowanie e-mailem działa dalej.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nasłuch. `0.0.0.0` jest świadome: sieć lokalna minipc jest traktowana jako zaufana.
HOST=0.0.0.0
PORT=3000

# --- Wykrywanie duplikatów: warstwa semantyczna i LLM (etap 12) --------------
# Cała warstwa jest wyłączalna jedną zmienną. Wyłączona nie psuje niczego:
# ostrzeżenie o podobnych ćwiczeniach liczy się wtedy leksykalnie, a tworzenie
# ćwiczeń działa bez zmian.
LLM_ENABLED=true

# Klucz OpenRoutera. Bez niego warstwa jest po prostu wyłączona — serwer wstaje
# normalnie i mówi o tym w logu. Klucz nigdy nie trafia do aplikacji mobilnej:
# wszystkie wywołania modeli wychodzą z backendu.
OPENROUTER_API_KEY=

# Model embeddingów. MUSI zwracać wektor o wymiarze zgodnym z kolumną
# `exercise_embeddings.embedding` (1024) — inny wymiar jest odrzucany przy
# zapisie, bo indeks HNSW ma wymiar wpisany w schemat. Nazwy modeli sprawdź
# w katalogu OpenRoutera; zmiana modelu wymaga przeliczenia wektorów.
EMBEDDING_MODEL=qwen/qwen3-embedding-0.6b

# Re-ranker (warstwa 3): ocenia kandydatów i pisze uzasadnienie. Można wyłączyć
# osobno — warstwy 1 i 2 dalej znajdują duplikaty, tylko bez komentarza.
RERANKER_MODEL=google/gemini-2.5-flash
RERANKER_ENABLED=true

# Limit czasu na wywołanie modelu. Krótki świadomie: ostrzeżenie o duplikacie
# jest podpowiedzią w trakcie pisania nazwy, więc lepiej jej nie pokazać niż
# kazać czekać.
LLM_TIMEOUT_MS=8000
